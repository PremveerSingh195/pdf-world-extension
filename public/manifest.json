{
  "manifest_version": 3,
  "name": "PDF Toolbox - All-in-One PDF Editor & Workspace",
  "version": "1.0.0",
  "description": "Complete client-side PDF editor, converter, organizer, and visual workflow automation toolbox.",
  "permissions": [
    "storage",
    "downloads"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "pdf.worker.min.js",
        "icons/*",
        "app.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
